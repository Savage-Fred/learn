# ==============================================================================
# Savage-Fred/learn .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Out-of-Git Personal User State (Strict Invariant §R4)
# ------------------------------------------------------------------------------
# The platform persists all personal progress, ratings, interview logs, and
# resumes strictly outside git in $LEARN_DATA_DIR or ~/.local/share/learn/.
# The rules below prevent accidental commit if state is directed locally.
personal_data/
local_data/
data/
.data/
learn_data/
.learn_data/
user_state/
local_state/

# Personal state files and database artifacts
user_profile.json
pinned_topics.json
pins/
ratings/
sessions/
interviews/
resumes/
telemetry/
*.jsonl
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal

# ------------------------------------------------------------------------------
# 2. Git Worktrees
# ------------------------------------------------------------------------------
.worktrees/
*.worktree/

# ------------------------------------------------------------------------------
# 3. Virtual Environments & Secrets
# ------------------------------------------------------------------------------
.venv
.venv/
.venv*
venv/
env/
ENV/
.env
.env.*
!.env.example

# ------------------------------------------------------------------------------
# 4. Python Bytecode, Caches & Build Artifacts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 5. Testing, Type Checking & Linting Artifacts
# ------------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# 6. Frontend / Node / MCP Client Artifacts
# ------------------------------------------------------------------------------
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 7. Agent Coordination & Framework Metadata
# ------------------------------------------------------------------------------
.agents/

# ------------------------------------------------------------------------------
# 8. Operating System & Editor Artifacts
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
*.bak
