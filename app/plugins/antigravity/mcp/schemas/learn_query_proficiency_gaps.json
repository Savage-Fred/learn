{
  "name": "learn_query_proficiency_gaps",
  "description": "Query proficiency gaps between user's ratings and target role/company.",
  "parameters": {
    "type": "object",
    "required": ["role_track"],
    "properties": {
      "role_track": {
        "type": "string",
        "enum": ["faang_swe_l5_l6", "faang_privacy_l6", "seceng_l4_l6", "research_eng_l4_l5"]
      },
      "target_level": {
        "type": "string",
        "enum": ["L4", "L5", "L6"],
        "default": "L6"
      },
      "target_company": {
        "type": "string",
        "default": "Google"
      }
    }
  }
}
